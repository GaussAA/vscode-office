{
  "name": "office-viewer-plus",
  "displayName": "Data File Viewer (Parquet, JSONL)",
  "description": "Fork of Office Viewer narrowed to what its maintainer actually opens: parquet with ZSTD support, and a JSONL tree viewer with a large-JSON array inspector.",
  "version": "7.1.0",
  "publisher": "GaussAA",
  "license": "MIT",
  "icon": "image/logo.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "keywords": [
    "parquet",
    "jsonl",
    "ndjson",
    "json"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/GaussAA/vscode-office/issues"
  },
  "homepage": "https://github.com/GaussAA/vscode-office#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GaussAA/vscode-office.git"
  },
  "activationEvents": [
    "onCommand:GaussAA.office.previewJson",
    "onCommand:GaussAA.office.compareParquet"
  ],
  "main": "./out/extension.js",
  "type": "module",
  "l10n": "./l10n",
  "contributes": {
    "iconThemes": [
      {
        "id": "office-material-icon-theme",
        "label": "Material Icon Theme (Office Viewer)",
        "path": "./theme/material-icons.json",
        "_watch": true
      }
    ],
    "commands": [
      {
        "command": "GaussAA.office.previewJson",
        "title": "Preview JSON",
        "category": "Data File Viewer"
      },
      {
        "command": "GaussAA.office.compareParquet",
        "title": "Compare Parquet Files",
        "category": "Data File Viewer"
      },
      {
        "command": "GaussAA.office.clearDataViewerCaches",
        "title": "Clear Data Viewer Caches",
        "category": "Data File Viewer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "GaussAA.office.previewJson",
          "group": "navigation",
          "when": "resourceExtname == '.json'"
        }
      ],
      "editor/context": [],
      "explorer/context": [
        {
          "command": "GaussAA.office.previewJson",
          "group": "navigation",
          "when": "resourceExtname == '.json'"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "GaussAA.parquetViewer",
        "displayName": "Parquet Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ]
      },
      {
        "viewType": "GaussAA.jsonlViewer",
        "displayName": "JSONL Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ]
      }
    ]
  },
  "scripts": {
    "dev": "vite --mode=development",
    "build": "vite build --mode=production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
    "lint": "oxlint --type-aware src test --deny-warnings",
    "lint:fix": "oxlint src --fix",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:update": "node scripts/typecheck.mjs --update",
    "typecheck:self-test": "node scripts/typecheck.mjs --self-test",
    "test": "tsx --test \"test/unit/*.test.ts\"",
    "test:smoke": "node scripts/smoke/build.mjs && vscode-test --label smoke-stable",
    "test:smoke:min": "node scripts/smoke/build.mjs && vscode-test --label smoke-min",
    "check": "pnpm format:check && pnpm lint && node scripts/check-baseline.mjs && pnpm typecheck && pnpm typecheck:self-test && pnpm test",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:full": "pnpm check && pnpm build && node scripts/check-bundled-imports.mjs && pnpm test:smoke && pnpm verify:ui && pnpm verify:perf",
    "verify:ui": "node scripts/ui-verify/runner.mjs",
    "verify:perf": "node scripts/perf/runner.mjs",
    "verify:ui:docs": "node scripts/ui-verify/runner.mjs --docs",
    "prepare": "husky",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "~1.125.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "hyparquet-writer": "^0.15.7",
    "less": "^4.2.0",
    "ovsx": "^1.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "puppeteer-core": "^25.1.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@vscode/codicons": "^0.0.45",
    "antd": "^6.7.0",
    "hyparquet": "^1.26.1",
    "hyparquet-compressors": "^1.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xml-formatter": "^3.7.0",
    "yaml": "^2.9.0"
  },
  "forkedFrom": "cweijan.vscode-office@4.2.2",
  "packageManager": "pnpm@12.16.1"
}
