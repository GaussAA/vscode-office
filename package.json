{
  "name": "office-viewer-plus",
  "displayName": "Data File Viewer (Parquet, JSONL, Excel)",
  "description": "Fork of Office Viewer narrowed to what its maintainer actually opens: spreadsheets (xls/xlsx/xlsm/csv/tsv/ods), parquet with ZSTD support, and a JSONL tree viewer.",
  "version": "6.11.0",
  "publisher": "GaussAA",
  "license": "MIT",
  "icon": "image/logo.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "keywords": [
    "excel",
    "xlsx",
    "xls",
    "csv",
    "tsv",
    "ods",
    "parquet",
    "jsonl",
    "ndjson",
    "spreadsheet"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/GaussAA/vscode-office/issues"
  },
  "homepage": "https://github.com/GaussAA/vscode-office#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GaussAA/vscode-office.git"
  },
  "activationEvents": [
    "onCommand:GaussAA.office.previewJson",
    "onCommand:GaussAA.office.compareParquet"
  ],
  "main": "./out/extension.js",
  "type": "module",
  "l10n": "./l10n",
  "contributes": {
    "iconThemes": [
      {
        "id": "office-material-icon-theme",
        "label": "Material Icon Theme (Office Viewer)",
        "path": "./theme/material-icons.json",
        "_watch": true
      }
    ],
    "commands": [
      {
        "command": "GaussAA.office.csv.switch",
        "title": "Switch CSV editor",
        "icon": "$(edit)"
      },
      {
        "command": "GaussAA.office.previewJson",
        "title": "Preview JSON",
        "category": "Data File Viewer"
      },
      {
        "command": "GaussAA.office.compareParquet",
        "title": "Compare Parquet Files",
        "category": "Data File Viewer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "GaussAA.office.csv.switch",
          "when": "resourceExtname == '.csv' || resourceExtname == '.tsv'",
          "group": "navigation@-2"
        },
        {
          "command": "GaussAA.office.previewJson",
          "group": "navigation",
          "when": "resourceExtname == '.json'"
        }
      ],
      "editor/context": [],
      "explorer/context": [
        {
          "command": "GaussAA.office.previewJson",
          "group": "navigation",
          "when": "resourceExtname == '.json'"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "GaussAA.officeViewer",
        "displayName": "Office Viewer",
        "selector": [
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "file:/**/*.csv"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.csv"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.ods"
          }
        ]
      },
      {
        "viewType": "GaussAA.parquetViewer",
        "displayName": "Parquet Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ]
      },
      {
        "viewType": "GaussAA.jsonlViewer",
        "displayName": "JSONL Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ]
      }
    ]
  },
  "scripts": {
    "dev": "vite --mode=development",
    "build": "vite build --mode=production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
    "lint": "oxlint --type-aware src test --deny-warnings",
    "lint:fix": "oxlint src --fix",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:update": "node scripts/typecheck.mjs --update",
    "typecheck:self-test": "node scripts/typecheck.mjs --self-test",
    "test": "tsx --test \"test/unit/*.test.ts\"",
    "test:smoke": "node scripts/smoke/build.mjs && vscode-test --label smoke-stable",
    "test:smoke:min": "node scripts/smoke/build.mjs && vscode-test --label smoke-min",
    "check": "pnpm format:check && pnpm lint && node scripts/check-baseline.mjs && pnpm typecheck && pnpm typecheck:self-test && pnpm test",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:full": "pnpm check && pnpm build && node scripts/check-bundled-imports.mjs && pnpm test:smoke && pnpm verify:ui && pnpm verify:perf",
    "verify:ui": "node scripts/ui-verify/runner.mjs",
    "verify:perf": "node scripts/perf/runner.mjs",
    "verify:ui:docs": "node scripts/ui-verify/runner.mjs --docs",
    "prepare": "husky",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "~1.125.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "hyparquet-writer": "^0.15.7",
    "less": "^4.2.0",
    "ovsx": "^1.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "puppeteer-core": "^25.1.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@cweijan/exceljs": "^5.0.3",
    "@vscode/codicons": "^0.0.45",
    "antd": "^6.7.0",
    "buffer": "^6.0.3",
    "hyparquet": "^1.26.1",
    "hyparquet-compressors": "^1.1.2",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-formatter": "^3.7.0",
    "yaml": "^2.9.0"
  },
  "forkedFrom": "cweijan.vscode-office@4.2.2",
  "packageManager": "pnpm@12.16.1"
}
