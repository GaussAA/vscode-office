{
  "name": "office-viewer-plus",
  "displayName": "Office Viewer Plus",
  "description": "Fork of Office Viewer (cweijan/vscode-office) with ZSTD parquet support and a JSONL tree viewer.",
  "version": "6.0.0",
  "publisher": "GaussAA",
  "license": "MIT",
  "icon": "image/logo.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "keywords": [
    "pdf",
    "word",
    "docx",
    "excel",
    "xlsx",
    "csv",
    "tsv",
    "powerpoint",
    "pptx",
    "epub",
    "svg",
    "psd",
    "xmind",
    "parquet",
    "zip",
    "archive",
    "font",
    "toml",
    "yaml",
    "xml",
    "git",
    "git-history"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "bugs": {
    "url": "https://github.com/GaussAA/vscode-office/issues"
  },
  "homepage": "https://github.com/GaussAA/vscode-office#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GaussAA/vscode-office.git"
  },
  "activationEvents": [
    "workspaceContains:.git/HEAD",
    "onWebviewPanel:office-git-history"
  ],
  "main": "./out/extension.js",
  "type": "module",
  "l10n": "./l10n",
  "contributes": {
    "iconThemes": [
      {
        "id": "office-material-icon-theme",
        "label": "Material Icon Theme (Office Viewer)",
        "path": "./theme/material-icons.json",
        "_watch": true
      }
    ],
    "commands": [
      {
        "command": "GaussAA.office.csv.switch",
        "title": "Switch CSV editor",
        "icon": "$(edit)"
      },
      {
        "command": "GaussAA.office.html.preview",
        "title": "Preview HTML"
      },
      {
        "command": "GaussAA.office.gitHistory.view",
        "title": "View Git History",
        "icon": "$(history)"
      },
      {
        "command": "GaussAA.office.gitHistory.viewFileHistory",
        "title": "Git: View File History",
        "icon": "$(git-commit)"
      },
      {
        "command": "GaussAA.office.gitHistory.quickSync",
        "title": "Git: Quick Sync",
        "icon": "$(sync)"
      }
    ],
    "keybindings": [
      {
        "command": "GaussAA.office.html.preview",
        "key": "ctrl+shift+v",
        "when": "editorTextFocus && editorLangId == html"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "GaussAA.office.gitHistory.view",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "GaussAA.office.gitHistory.quickSync",
          "group": "navigation",
          "when": "scmProvider == git && config.vscode-office.gitHistory.quickSyncButton"
        }
      ],
      "scm/repository": [
        {
          "command": "GaussAA.office.gitHistory.view",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "GaussAA.office.gitHistory.viewFileHistory",
          "when": "config.git.enabled && gitOpenRepositoryCount != 0"
        }
      ],
      "editor/title": [
        {
          "command": "GaussAA.office.gitHistory.viewFileHistory",
          "group": "navigation@4",
          "when": "config.git.enabled && gitOpenRepositoryCount != 0 && resourceScheme == file"
        },
        {
          "command": "GaussAA.office.csv.switch",
          "when": "resourceExtname == '.csv' || resourceExtname == '.tsv'",
          "group": "navigation@-2"
        }
      ],
      "editor/context": [
        {
          "command": "GaussAA.office.gitHistory.viewFileHistory",
          "group": "git",
          "when": "config.git.enabled && gitOpenRepositoryCount != 0 && resourceScheme == file"
        },
        {
          "command": "GaussAA.office.html.preview",
          "group": "navigation@1",
          "when": "editorTextFocus && editorLangId == html"
        }
      ],
      "explorer/context": [
        {
          "command": "GaussAA.office.gitHistory.viewFileHistory",
          "group": "git",
          "when": "config.git.enabled && gitOpenRepositoryCount != 0 && resourceScheme == file"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "GaussAA.officeViewer",
        "displayName": "Office Viewer",
        "selector": [
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "file:/**/*.csv"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.csv"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.ods"
          },
          {
            "filenamePattern": "file:/**/*.docx"
          },
          {
            "filenamePattern": "vscode-vfs:/**/*.docx"
          },
          {
            "filenamePattern": "vscode-remote:/**/*.docx"
          },
          {
            "filenamePattern": "*.dotx"
          },
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.pptm"
          },
          {
            "filenamePattern": "*.pdf"
          },
          {
            "filenamePattern": "*.epub"
          },
          {
            "filenamePattern": "*.ttf"
          },
          {
            "filenamePattern": "*.woff"
          },
          {
            "filenamePattern": "*.woff2"
          },
          {
            "filenamePattern": "*.otf"
          },
          {
            "filenamePattern": "*.svg"
          },
          {
            "filenamePattern": "*.icns"
          },
          {
            "filenamePattern": "*.psd"
          },
          {
            "filenamePattern": "*.xmind"
          },
          {
            "filenamePattern": "*.tiff"
          },
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.heif"
          },
          {
            "filenamePattern": "*.heic"
          }
        ]
      },
      {
        "viewType": "GaussAA.archiveViewer",
        "displayName": "Archive Viewer",
        "selector": [
          {
            "filenamePattern": "*.jar"
          },
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.7z"
          },
          {
            "filenamePattern": "*.rar"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.apk"
          },
          {
            "filenamePattern": "*.vsix"
          },
          {
            "filenamePattern": "*.crx"
          }
        ]
      },
      {
        "viewType": "GaussAA.imageViewer",
        "displayName": "Image Preview (Office Viewer)",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.gif"
          },
          {
            "filenamePattern": "*.apng"
          },
          {
            "filenamePattern": "*.bmp"
          },
          {
            "filenamePattern": "*.ico"
          },
          {
            "filenamePattern": "*.cur"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.pjpeg"
          },
          {
            "filenamePattern": "*.pjp"
          },
          {
            "filenamePattern": "*.webp"
          }
        ]
      },
      {
        "viewType": "GaussAA.htmlViewer",
        "displayName": "Html Viewer",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.htm"
          },
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.xhtml"
          }
        ]
      },
      {
        "viewType": "GaussAA.parquetViewer",
        "displayName": "Parquet Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ]
      },
      {
        "viewType": "GaussAA.classViewer",
        "displayName": "Java Decompiler",
        "selector": [
          {
            "filenamePattern": "file:/**/*.class"
          }
        ]
      },
      {
        "viewType": "GaussAA.jsonlViewer",
        "displayName": "JSONL Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "Git History",
        "order": 98,
        "properties": {
          "vscode-office.gitHistory.quickSyncButton": {
            "type": "boolean",
            "default": false,
            "description": "Show Quick Sync button in Source Control (Git) title toolbar."
          }
        }
      }
    ]
  },
  "scripts": {
    "dev": "vite --mode=development",
    "build": "vite build --mode=production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
    "vscode:prepublish": "pnpm run build",
    "lint": "oxlint --type-aware src test --deny-warnings",
    "lint:fix": "oxlint src --fix",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:update": "node scripts/typecheck.mjs --update",
    "typecheck:self-test": "node scripts/typecheck.mjs --self-test",
    "test": "tsx --test \"test/unit/*.test.ts\"",
    "test:smoke": "node scripts/smoke/build.mjs && vscode-test --label smoke-stable",
    "test:smoke:min": "node scripts/smoke/build.mjs && vscode-test --label smoke-min",
    "check": "pnpm format:check && pnpm lint && node scripts/check-baseline.mjs && pnpm typecheck && pnpm typecheck:self-test && pnpm test",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:full": "pnpm check && pnpm build && node scripts/check-bundled-imports.mjs && pnpm test:smoke && pnpm verify:ui",
    "verify:ui": "node scripts/ui-verify/runner.mjs",
    "verify:ui:docs": "node scripts/ui-verify/runner.mjs --docs",
    "prepare": "husky",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-image-gallery": "^1.2.4",
    "@types/vscode": "~1.125.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "2.1.1",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "ovsx": "^1.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "puppeteer-core": "^25.1.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@ant-design/icons": "^6.3.4",
    "@cantoo/pdf-lib": "^2.11.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@cweijan/exceljs": "^5.0.3",
    "@docx-editor.dev/react": "2.34.0",
    "@lezer/highlight": "^1.2.3",
    "@mind-elixir/import-xmind": "^1.0.8",
    "@vscode/codicons": "^0.0.45",
    "@zip.js/zip.js": "^2.8.26",
    "ag-psd": "^30.1.1",
    "antd": "^6.7.0",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "epubjs": "^0.3.93",
    "file-type": "^19.6.0",
    "heic2any": "^0.0.4",
    "hyparquet": "^1.26.1",
    "hyparquet-compressors": "^1.1.2",
    "hyparquet-writer": "^0.15.7",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "mind-elixir": "^5.12.2",
    "node-unrar-js": "^2.0.2",
    "opentype.js": "1.3.4",
    "pptxviewjs": "^1.1.9",
    "pretty-bytes": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-gallery": "^1.3.0",
    "tar": "^7.5.16",
    "utif2": "^4.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xml-formatter": "^3.7.0",
    "yaml": "^2.9.0"
  },
  "forkedFrom": "cweijan.vscode-office@4.2.2",
  "packageManager": "pnpm@12.16.1"
}
