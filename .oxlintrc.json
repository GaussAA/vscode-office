// oxlint config — replaces ESLint.
//
// Why: the ESLint stack pinned `typescript <6.1` through @typescript-eslint's peer range,
// which blocked TypeScript 7 (see #18). oxlint does not depend on the TypeScript package
// at all, runs the whole tree in under a second, and understands the TS/JSX syntax we use.
//
// Scope is deliberately the same as the old gate: `src/**/*.{ts,tsx}` only. The vendored
// JavaScript under `src/**/*.js` (x-spreadsheet, markdown-it plugins) was never linted and
// is not being dragged in by a tool swap.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn", "oxc"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // `except-parens` is the ESLint default and matches the idiom this codebase uses
    // (`if ((match = re.exec(line)))`): the extra parentheses are the signal that the
    // assignment is intentional. Every site that relied on the implicit form was given
    // explicit parentheses rather than the rule being turned off.
    "no-cond-assign": ["error", "except-parens"],

    "no-unused-vars": [
      "error",
      { "args": "none", "caughtErrors": "none", "varsIgnorePattern": "^_", "argsIgnorePattern": "^_" }
    ],
  },
  "ignorePatterns": [
    "**/*.d.ts",
    "src/**/*.js",
    "vditor/**",
    "out/**",
    "node_modules/**",
    ".vscode-test/**"
  ]
}
