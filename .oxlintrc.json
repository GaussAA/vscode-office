// oxlint config — replaces ESLint.
//
// Why: the ESLint stack pinned `typescript <6.1` through @typescript-eslint's peer range,
// which blocked TypeScript 7 (see #18). oxlint does not depend on the TypeScript package
// at all, runs the whole tree in under a second, and understands the TS/JSX syntax we use.
//
// Scope: every hand-written `.ts`/`.tsx` in `src/` **and** `test/`. The only JavaScript left
// in the tree is the vendored x-spreadsheet engine under `src/react/view/excel/x-spreadsheet/`,
// which is a fork (ADR-0009) and stays excluded — everything we wrote ourselves is now `.ts`.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "unicorn", "oxc"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // `except-parens` is the ESLint default and matches the idiom this codebase uses
    // (`if ((match = re.exec(line)))`): the extra parentheses are the signal that the
    // assignment is intentional. Every site that relied on the implicit form was given
    // explicit parentheses rather than the rule being turned off.
    "no-cond-assign": ["error", "except-parens"],

    // node:test hands every `test()` a promise that is handled by the runner itself; awaiting
    // it in 40 call sites would be noise, and the type-aware pass only sees the call at all
    // once `out/unit-tests/` exists — so the exception is spelled out instead of incidental.
    "typescript/no-floating-promises": [
      "error",
      { "allowForKnownSafeCalls": [{ "from": "package", "name": "test", "package": "node:test" }] }
    ],

    "no-unused-vars": [
      "error",
      {
        "args": "none",
        "caughtErrors": "none",
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "**/*.d.ts",
    "src/react/view/excel/x-spreadsheet/**",
    "vditor/**",
    "out/**",
    "node_modules/**",
    ".vscode-test/**"
  ]
}
