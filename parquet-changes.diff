@@ -0,0 +1,73 @@
+import { useCallback, useRef, useState } from "react";
+import type { CellCursor } from "./parquetCell.tsx";
+
+interface UseParquetCursorOptions {
+  onCursorChange?: (cursor: CellCursor | null) => void;
+}
+
+/**
+ * Manages cell cursor state and navigation for the Parquet table.
+ *
+ * The cursor is kept in both state and ref:
+ * - State triggers React re-renders
+ * - Ref allows rapid keyboard navigation before re-renders
+ */
+export function useParquetCursor(options: UseParquetCursorOptions = {}) {
+  const [cursor, setCursor] = useState<CellCursor | null>(null);
+  const cursorRef = useRef<CellCursor | null>(null);
+
+  /**
+   * Select a cell and update both state and ref.
+   *
+   * @param next - The cell cursor to select, or null to clear selection
+   */
+  const selectCell = useCallback(
+    (next: CellCursor | null) => {
+      cursorRef.current = next;
+      setCursor(next);
+      options.onCursorChange?.(next);
+    },
+    [options],
+  );
+
+  /**
+   * Clear the current cell selection.
+   */
+  const clearCursor = useCallback(() => {
+    selectCell(null);
+  }, [selectCell]);
+
+  /**
+   * Move the cursor relative to its current position.
+   *
+   * @param delta - Row and column offsets to apply
+   * @example
+   * ```ts
+   * moveCursor({ row: 1, col: 0 }); // Move down one row
+   * moveCursor({ row: 0, col: -1 }); // Move left one column
+   * ```
+   */
+  const moveCursor = useCallback(
+    (delta: { row?: number; col?: number }) => {
+      const current = cursorRef.current;
+      if (!current) return;
+
+      const nextRow = current.row + (delta.row ?? 0);
+      const nextCol = current.col + (delta.col ?? 0);
+
+      selectCell({
+        row: nextRow,
+        col: nextCol,
+      });
+    },
+    [selectCell],
+  );
+
+  return {
+    cursor,
+    cursorRef,
+    selectCell,
+    clearCursor,
+    moveCursor,
+  };
+}
diff --git a/src/react/view/parquet/useParquetDocument.ts b/src/react/view/parquet/useParquetDocument.ts
new file mode 100644
index 00000000..6f73ae37
--- /dev/null
+++ b/src/react/view/parquet/useParquetDocument.ts
@@ -0,0 +1,88 @@
+/**
+ * Document Loading Management for Parquet Viewer
+ *
+ * Manages the lifecycle of Parquet file loading, including:
+ * - File opening and reopening
+ * - Loading and error states
+ * - File metadata and column profiling data
+ * - Sequence tracking to handle concurrent requests
+ *
+ * @module useParquetDocument
+ */
+
+import { useCallback, useRef, useState } from "react";
+import type { ParquetFileInfo } from "./parquetParser.ts";
+import type { ParquetProfile } from "@/common/parquetProfileTypes";
+
+/**
+ * Manages Parquet file loading and metadata state.
+ *
+ * Handles:
+ * - File opening and reopening
+ * - Loading states
+ * - Error states
+ * - File metadata (row count, columns, codecs)
+ * - Column profiling data
+ *
+ * @returns Document state and control functions
+ */
+export function useParquetDocument() {
+  const [fileInfo, setFileInfo] = useState<ParquetFileInfo | null>(null);
+  const [profile, setProfile] = useState<ParquetProfile | null>(null);
+  const [error, setError] = useState<Error | null>(null);
+  const [loading, setLoading] = useState(true);
+
+  const fileInfoRef = useRef<ParquetFileInfo | null>(null);
+  const documentKeyRef = useRef<string | undefined>(undefined);
+  const openSeqRef = useRef(0);
+
+  const updateFileInfo = useCallback((info: ParquetFileInfo | null) => {
+    setFileInfo(info);
+    fileInfoRef.current = info;
+  }, []);
+
+  const updateProfile = useCallback((prof: ParquetProfile | null) => {
+    setProfile(prof);
+  }, []);
+
+  const updateError = useCallback((err: Error | null) => {
+    setError(err);
+    setLoading(false);
+  }, []);
+
+  const updateLoading = useCallback((isLoading: boolean) => {
+    setLoading(isLoading);
+  }, []);
+
+  const startOpen = useCallback(() => {
+    const seq = ++openSeqRef.current;
+    setLoading(true);
+    setError(null);
+    return seq;
+  }, []);
+
+  const isCurrentOpen = useCallback((seq: number) => {
+    return seq === openSeqRef.current;
+  }, []);
+
+  const setDocumentKey = useCallback((key: string | undefined) => {
+    documentKeyRef.current = key;
+  }, []);
+
+  return {
+    fileInfo,
+    fileInfoRef,
+    profile,
+    error,
+    loading,
+    documentKeyRef,
+    openSeqRef,
+    updateFileInfo,
+    updateProfile,
+    updateError,
+    updateLoading,
+    startOpen,
+    isCurrentOpen,
+    setDocumentKey,
+  };
+}
diff --git a/src/react/view/parquet/useParquetInspector.ts b/src/react/view/parquet/useParquetInspector.ts
