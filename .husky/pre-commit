#!/bin/sh
# Pre-commit: everything that must never regress, in cheap-to-expensive order.
#
# 1. Prettier over OUR docs only (~1.5s). `src/` is not auto-formatted yet: upstream
#    style (4 spaces, single quotes) still dominates it, and mixing a format pass into
#    a feature commit makes both unreviewable. Adopting prettier repo-wide is its own
#    commit (see AGENTS.md).
# 2. `pnpm check` = lint + typecheck + test (~15s warm). Each gate fails closed:
#    eslint reports zero problems, tsc must not introduce an error outside the
#    checked-in baseline, and node:test guards the parser edge cases.
pnpm exec lint-staged
pnpm check
