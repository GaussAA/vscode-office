#!/bin/sh
# Pre-commit: every gate that must never regress, in one command.
#
# `pnpm check` = format:check + lint + baseline + typecheck + typecheck:self-test + test
# (~15s warm). Each gate fails closed:
#   format:check        -> oxfmt finds a difference (`pnpm format` is the fix)
#   lint                -> oxlint reports anything at all
#   baseline            -> engines / @types / a runtime dependency's engines.node disagree
#   typecheck           -> a type error that is not in the (empty) baseline
#   typecheck:self-test -> the type gate failed to see an injected error, so it proves nothing
#   test                -> node:test
#
# There is no per-file auto-format step: oxfmt rewrites the whole tree in ~300ms, and
# lint-staged's "pass every staged path as argv" is exactly what breaks on a large commit
# (Windows caps the command line, so the 434-file reformat commit died with an argument
# list that was too long). One command, one source of truth.
pnpm check