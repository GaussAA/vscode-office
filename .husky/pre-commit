# Fast, staged-only: Prettier over OUR docs only.
#
# Upstream files (src/, vite/, template/, …) are deliberately NOT auto-formatted:
# upstream uses a different style (4 spaces, single quotes) and we must stay
# mergeable with it. Write fork code in upstream style instead.
pnpm exec lint-staged

# Unit tests: ~2s (esbuild bundles three modules, then node --test). They guard the
# parser edge cases that DOM assertions cannot see, e.g. the countNodes 500/501
# off-by-one that shipped once.
pnpm test

