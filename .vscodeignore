# Everything here is never loaded at runtime. `pnpm check-release` and `vsce` both read this
# file, so an entry for a path that does not exist is a claim nobody is checking -- keep it
# to real files.

.vscode/**
.vscode-test/**
.idea/
.github/**

# Sources, tests and build inputs: `out/` holds the only thing the extension host loads.
src/**
test/**
out/test/**
**/tsconfig.json
**/*.map
**/*.ts

# pnpm scaffolding and the scripts that build the extension.
node_modules/
pnpm-lock.yaml
pnpm-workspace.yaml
scripts/**

# Lockfiles of other package managers, if a contributor has one lying around.
.gitignore
package-lock.json
bun.lock
yarn.lock

# Agent-facing docs, screenshots and release material.
docs/**
.ui-verify/**
.perf/**
.agents/**
.impeccable/**
AGENTS.md
CLAUDE.md
GLOSSARY.md
DESIGN.md
PRODUCT.md
*.vsix

# Build reports: the visualizer writes a 1.7 MB HTML file that no code path loads.
stats/**

# Dev scaffolding: formatter/linter config, the smoke runner's config, the Vite dev page.
.husky/**
.oxlintrc.json
.oxfmtrc.json
.vscode-test.mjs
.nvmrc
index.html
.git-blame-ignore-revs
.review-tmp/**
