# Everything here is never loaded at runtime. `pnpm check-release` and `vsce` both read this
# file, so an entry for a path that does not exist is a claim nobody is checking -- keep it
# to real files.

.vscode/**
.vscode-test/**
.idea/
.github/**

# Sources, tests and build inputs: `out/` holds the only thing the extension host loads.
src/**
test/**
out/test/**
template/**
**/tsconfig.json
**/*.map
**/*.ts

# Two pnpm workspace packages and the scripts that build them.
node_modules/
vditor/
pnpm-lock.yaml
pnpm-workspace.yaml
vite/
scripts/**
public/**

# Lockfiles of other package managers, if a contributor has one lying around.
.gitignore
package-lock.json
bun.lock
yarn.lock

# Agent-facing docs, screenshots and release material.
docs/**
.ui-verify/**
AGENTS.md
CLAUDE.md
GLOSSARY.md
*.vsix

# Dev scaffolding: formatter/linter config, the smoke runner's config, the Vite dev page.
.husky/**
.oxlintrc.json
.oxfmtrc.json
.vscode-test.mjs
index.html
.git-blame-ignore-revs
